{
  "expo": {
    "name": "MundaWise",
    "slug": "mundawise",
    "version": "1.0.1",
    "orientation": "portrait",
    "scheme": "mundawise",
    "icon": "./assets/mundawise-icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/mundawise-splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1B4332"
    },
    "android": {
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/mundawise-icon.png",
        "backgroundColor": "#1B4332"
      },
      "package": "com.bluewave.mundawise",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyCmNM-KChGE3sLn5n_kNqJOITRj5rbOrgA"
        }
      }
    },
    "ios": {
      "bundleIdentifier": "com.bluewave.mundawise",
      "infoPlist": {
        "NSCameraUsageDescription": "MundaWise needs camera access to photograph crop leaves for AI diagnosis.",
        "NSPhotoLibraryUsageDescription": "MundaWise needs gallery access to import crop photos for diagnosis.",
        "NSLocationWhenInUseUsageDescription": "MundaWise uses your location to find the nearest agro-dealers."
      }
    },
    "web": {
      "favicon": "./assets/mundawise-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "MundaWise needs camera access to photograph crop leaves for AI diagnosis."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "MundaWise uses your location to find the nearest agro-dealer.",
          "locationWhenInUsePermission": "MundaWise uses your location to find the nearest agro-dealer."
        }
      ],
      [
        "react-native-fast-tflite",
        {
          "enableCoreMLDelegate": false,
          "enableGpuDelegate": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "c5899e3f-9890-4f59-af9b-9620af51ab6c"
      }
    }
  }
}
